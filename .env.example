# ——— KI-Anbieter wählen ———
# "gemini" oder "openai" (wenn leer: Gemini-Key hat Vorrang, sonst OpenAI)
AI_PROVIDER=gemini

# ——— Google Gemini (kostenloses Kontingent möglich) ———
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=dein-gemini-key-hier
GEMINI_MODEL=gemini-2.5-flash-lite

# ——— OpenAI (Alternative) ———
# Key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Server-Port
PORT=3000

# ——— Supabase (Datenbank – empfohlen) ———
# Project Settings → API → Project URL + service_role key (geheim!)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Login-System (Pflicht für Registrierung/Anmeldung – min. 32 Zeichen)
JWT_SECRET=dein-sehr-langer-zufaelliger-geheimer-schluessel-min-32-zeichen

# Optional Legacy: falls JWT_SECRET fehlt, wird SITE_PASSWORD als Fallback genutzt
# SITE_PASSWORD=

# ——— Google & Apple Anmeldung (optional) ———
# Google: https://console.cloud.google.com/apis/credentials
# OAuth-Client „Webanwendung“, autorisierte JavaScript-Quellen + Redirects:
#   http://localhost:3000
#   https://pocketaid.netlify.app
GOOGLE_CLIENT_ID=

# Apple: https://developer.apple.com/account/resources/identifiers/list/serviceId
# Services ID, Return URL = https://deine-domain.netlify.app/login.html (und /register.html)
APPLE_CLIENT_ID=

# ——— Enable Banking (echte Bank-Transaktionen) ———
# sandbox = Test | production = echte Banken (eigene Production-App nötig!)
# Registrierung: https://enablebanking.com/sign-in/
ENABLE_BANKING_ENV=production
ENABLE_BANKING_APP_ID=deine-production-app-id-uuid
ENABLE_BANKING_PRIVATE_KEY_PATH=./keys/enable-banking-private.pem
# Lokal:
ENABLE_BANKING_REDIRECT_URL=http://localhost:3000/api/banking/callback
# Netlify (nach Deploy – NAME anpassen):
# ENABLE_BANKING_REDIRECT_URL=https://pocketaid.netlify.app/api/banking/callback
# Optional: wie viele Tage Historie bei "Jetzt aktualisieren" geholt werden
# Standard = 3650 (ca. 10 Jahre)
# BANKING_HISTORY_DAYS=3650
# Fetch-Strategie: "default" (empfohlen), "longest" oder "both"
# BANKING_FETCH_STRATEGY=default
# PEM auf Netlify als Variable (mehrzeilig):
# ENABLE_BANKING_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...
ENABLE_BANKING_COUNTRY=AT
